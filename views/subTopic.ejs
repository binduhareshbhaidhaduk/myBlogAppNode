<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
    integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

  <link rel="stylesheet" href="./css/style.css">

  <style>
    /* Add your primary color here */
    body {
      font-family: Arial, sans-serif;
      background-color: #f7f7f7;
      /* Light background for contrast */
    }

    form {
      background-color: #007bff;
      /* Primary color for the form background */
      color: white;
      /* Text color */
      padding: 20px;
      border-radius: 8px;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      max-width: 400px;
      margin: auto;
    }

    label {
      display: block;
      margin-bottom: 8px;
    }

    input[type="text"],
    textarea,
    select {
      width: 95%;
      padding: 10px;
      margin-bottom: 15px;
      border: none;
      border-radius: 4px;
      background-color: white !important;
    }

    button {
      background-color: #2878ce;
      /* Darker shade of primary color for button */
      color: white;
      border: none;
      padding: 10px 15px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 16px;
    }

    button:hover {
      background-color: #004494;
      /* Even darker shade on hover */
    }
  </style>
</head>

<body>
  <%- include("partials/header.ejs") %>

    <form action="/subtopics" method="POST" class="p-3 mt-3">
      <div>
        <label for="subtopicName">Subtopic Name</label>
        <input type="text" id="subtopicName" name="subtopicName" required />
      </div>
      <div>
        <label for="subtopicDescription">Subtopic Description</label>
        <textarea id="subtopicDescription" name="subtopicDescription" required></textarea>
      </div>
      <div>
        <label for="topic">Select Topic</label>
        <select id="topic" name="topic" required>
          <% topics.forEach(function(t) { %>
            <option value="<%= t._id %>">
              <%= t.topic %>
            </option>
            <% }); %>
        </select>
      </div>
      <button type="submit">Add Subtopic</button>
    </form>

    <!-- footer -->
    <%- include('./partials/footer.ejs') %>
</body>

</html>